# Copy this file to .env and fill in one live data provider key.
# .env is ignored by git.

ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# STOOQ_API_KEY=your_stooq_key_here

# --- Social media figure tracking (all optional, degrade gracefully) ---

# Optional Bearer token for the Truth Social public API.
# Leave empty to use anonymous public access.
# TRUTHSOCIAL_TOKEN=

# Comma-separated list of Nitter instances used to fetch X timelines.
# Leave empty to use the built-in default instances.
# NITTER_INSTANCES=https://nitter.net,https://nitter.poast.org

# Optional X guest token used by the experimental GraphQL backend.
# X_GUEST_TOKEN=
